{
  "version": 2,
  "crons": [
    {"path": "/api/cron/toeic-scrape-trigger", "schedule": "0 22 * * *"},
    {"path": "/api/cron/toeic-generate-batch", "schedule": "0 23,10,16 * * *"},
    {"path": "/api/cron/toeic-generate-batch", "schedule": "30 4 * * *"}
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  }
}
